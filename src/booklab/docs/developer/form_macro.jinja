##
## Jinja2 macro to render a HTML field in a form
## Author: Petre Iordanescu (petre.iordanescu@gmail.com)
##


{% macro render_field(field) %} 
  <dt>{{ field.label }}</dt>
  <dd>{{ field(**kwargs)|safe }}
    {% if field.errors %} 
      <ul class=errors>
        {% for error in field.errors %}
          <li>{{ error }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </dd>
{% endmacro %}

